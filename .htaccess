RewriteEngine On

# 1. Si el usuario escribe /Login.php, lo redirige automáticamente a /Login
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\s]+)\.php\ HTTP [NC]
RewriteRule ^([^\s]+)\.php$ /$1 [R=301,L]

# 2. Si el usuario escribe /Login, el servidor busca internamente Login.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]